datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum Gender {
  MALE
  FEMALE
}

enum Belt {
  WHITE
  BLUE
  YELLOW
  RED
  ORANGE
  GREEN
  PURPLE
  BROWN
  BLACK
}

enum BracketStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum Modality {
  KATA
  KUMITE
}

model Tournament {
  id          String       @id @default(cuid())
  name        String
  createdAt   DateTime     @default(now())
  competitors Competitor[]
  Bracket     Bracket[]
}

model Competitor {
  id             String     @id @default(cuid())
  name           String
  gender         Gender
  weight         Float?
  birthdate      DateTime
  belt           Belt
  school         String
  kata           Boolean    @default(false)
  kumite         Boolean    @default(false)
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id])
  age            Int
  kataCategory   String?
  kumiteCategory String?
  createdAt      DateTime   @default(now())

  @@index([tournamentId])
}

model Bracket {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  category String
  modality Modality

  totalSlots  Int
  totalRounds Int

  status BracketStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@unique([tournamentId, category])
  @@index([tournamentId])
  @@index([category])
  @@index([status])
}

model Match {
  id        String  @id @default(cuid())
  bracketId String
  bracket   Bracket @relation(fields: [bracketId], references: [id], onDelete: Cascade)

  round    Int
  position Int

  akaId String?
  aoId  String?

  winnerId String?

  akaScore Int? @default(0)
  aoScore  Int? @default(0)

  decisionByHantei Boolean @default(false)
  akaSenshu        Boolean @default(false)
  aoSenshu         Boolean @default(false)

  isBye        Boolean @default(false)
  isWalkover   Boolean @default(false)
  isThirdPlace Boolean @default(false)

  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  // "Um match por posição" é garantido pelo banco, não só pela lógica de
  // geração em bracket-generator.ts — protege contra corrida de
  // requisições ou algum caminho futuro criando uma linha duplicada, o
  // que faria os updateMany() de propagação (matches/[matchId]/route.ts
  // e propagateByeWinners) atualizarem silenciosamente múltiplas linhas.
  @@unique([bracketId, round, position])
  @@index([bracketId])
  @@index([round])
  @@index([isThirdPlace])
}

model LiveMatch {
  id           String @id @default(cuid())
  tournamentId String @unique
  matchId      String
  bracketId    String

  akaId     String
  akaName   String
  akaSchool String
  aoId      String
  aoName    String
  aoSchool  String

  category    String
  modality    String
  round       Int
  position    Int
  totalRounds Int    @default(4)

  akaScore  Int     @default(0)
  aoScore   Int     @default(0)
  akaChui   Int     @default(0)
  aoChui    Int     @default(0)
  akaSenshu Boolean @default(false)
  aoSenshu  Boolean @default(false)

  timeRemaining Int       @default(-1)
  timerRunning  Boolean   @default(false)
  timerEndAt    DateTime?

  winner String?

  isActive  Boolean  @default(true)
  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([matchId])
}
